---
import { Picture } from 'astro:assets';
import { SITE } from '../site';
import bulle from '../assets/redbubble/bulle.jpg';
import ile from '../assets/redbubble/ile.jpg';
import bougie from '../assets/redbubble/bougie.jpg';
import fleur from '../assets/redbubble/fleur.jpg';

// Exemples de vêtements avec mes dessins, en vente sur ma boutique Redbubble.
const exemples = [
  { image: bulle, titre: 'Monde-bulle enraciné', produit: 'T-shirt' },
  { image: ile, titre: 'Île flottante', produit: 'T-shirt oversize' },
  { image: bougie, titre: 'Bougie magique', produit: 'Sweat à capuche' },
  { image: fleur, titre: 'Fleur emportée par le vent', produit: 'Sweat-shirt' },
];
---
<section class="redbubble" aria-labelledby="redbubble-titre">
  <p class="eyebrow">Ma boutique en ligne</p>
  <h2 id="redbubble-titre">Mes dessins sur t-shirts et sweats</h2>
  <p class="lead">
    Mes mondes imaginaires à l'encre noire sont imprimés à la demande sur des t-shirts, sweats,
    stickers, posters et bien d'autres objets, via ma boutique Redbubble, qui s'occupe de la
    fabrication et de la livraison.
  </p>
  <ul class="exemples">
    {exemples.map((e) => (
      <li>
        <a href={SITE.redbubble} target="_blank" rel="noopener">
          <div class="cadre">
            <Picture
              src={e.image}
              alt={`${e.produit} avec le dessin « ${e.titre} » de Sev`}
              widths={[265]}
              formats={['avif', 'webp']}
            />
          </div>
          <span class="titre">{e.titre}</span>
          <span class="produit">{e.produit}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="btn-row">
    <a class="btn" href={SITE.redbubble} target="_blank" rel="noopener">Voir ma boutique Redbubble</a>
  </div>
</section>

<style>
  .redbubble { margin-top: clamp(40px, 6vw, 64px); }
  .exemples {
    list-style: none;
    margin: 28px 0 32px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 28px 20px;
  }
  .exemples a { display: grid; gap: 4px; text-decoration: none; color: var(--ink); }
  .cadre {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: #f9f9f9;
    margin-bottom: 8px;
  }
  .cadre :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .exemples a:hover .cadre :global(img) { transform: scale(1.04); }
  .titre { font-family: var(--f-title); font-size: 1.1rem; font-weight: 600; }
  .exemples a:hover .titre { color: var(--pink); }
  .produit { color: var(--muted); font-size: 0.95rem; }
</style>
